@@ -0,0 +1,25 @@
+#ifndef _SYNETLOBBY_H_
+#define _SYNETLOBBY_H_
+
+#include <PR/ultratypes.h>
+#include <ssb_types.h>
+
+/* Port-only: glue between the UDP lobby/lockstep transport (port/netplay)
+ * and the game. See docs/netplay.md. */
+
+extern sb32 syNetLobbyIsMatch(void);
+extern void syNetLobbyFrame(void);                 /* once per frame, from the port loop */
+extern void syNetLobbyBeginHostMatch(void);        /* top of scVSBattleStartBattle */
+extern void syNetLobbyStartVSSession(void);        /* after syNetInputStartVSSession */
+extern void syNetLobbyStopVSSession(void);
+extern sb32 syNetLobbyCheckExecutionReady(void);
+extern sb32 syNetLobbyCheckInputsReady(u32 tick);  /* called by syNetInputFuncRead */
+extern void syNetLobbySetHeld(sb32 is_held);
+extern void syNetLobbySampleLocal(u32 tick);       /* sample hardware, store for tick + delay */
+extern sb32 syNetLobbyGetFrame(s32 player, u32 tick, u16 *buttons, s8 *stick_x, s8 *stick_y);
+extern sb32 syNetLobbyIsParticipant(s32 player);
+extern s32 syNetLobbyGetFighterCount(void);
+extern const char *syNetLobbyGetFighterName(s32 index);
+extern s32 syNetLobbyGetFighterKind(s32 index);
+
+#endif
diff --git a/src/sys/netpeer.c b/src/sys/netpeer.c
index b3c4960..22df878 100644
--- a/src/sys/netpeer.c
+++ b/src/sys/netpeer.c
@@ -4,6 +4,7 @@
 #include <gr/ground.h>
 #include <sc/scmanager.h>
 #include <sys/netinput.h>
+#include <sys/netlobby.h>
 #include <sys/netreplay.h>
 #include <sys/netsync.h>
 #include <sys/utils.h>
@@ -903,6 +904,12 @@ void syNetPeerStartVSSession(void)
 
 sb32 syNetPeerCheckBattleExecutionReady(void)
 {
+#ifdef PORT
+	if (syNetLobbyIsMatch() != FALSE)
+	{
+		return syNetLobbyCheckExecutionReady();
+	}
+#endif
 	if ((sSYNetPeerIsEnabled == FALSE) || (sSYNetPeerBootstrapIsEnabled == FALSE) ||
 		(sSYNetPeerBattleBarrierEnabled == FALSE))
 	{
