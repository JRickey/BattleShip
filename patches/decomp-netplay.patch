+	"Yoshi", "Captain Falcon", "Kirby", "Pikachu", "Jigglypuff", "Ness"
+};
+
+s32 syNetLobbyGetFighterCount(void)
+{
+	return nFTKindPlayableEnd - nFTKindPlayableStart + 1;
+}
+
+const char *syNetLobbyGetFighterName(s32 index)
+{
+	if ((index < 0) || (index >= syNetLobbyGetFighterCount()))
+	{
+		return "?";
+	}
+	return sSYNetLobbyFighterNames[index];
+}
+
+s32 syNetLobbyGetFighterKind(s32 index)
+{
+	if ((index < 0) || (index >= syNetLobbyGetFighterCount()))
+	{
+		index = 0;
+	}
+	return nFTKindPlayableStart + index;
+}
+
+sb32 syNetLobbyIsMatch(void)
+{
+	return sSYNetLobbyIsMatch;
+}
+
+sb32 syNetLobbyIsClient(void)
+{
+	return (np_state() == NP_CONNECTED) ? TRUE : FALSE;
+}
+
+s32 syNetLobbyGetRemoteCount(void)
+{
+	s32 slot, count = 0;
+
+	if (np_state() != NP_HOSTING)
+	{
+		return 0;
+	}
+	if (np_get_host_costume() >= 0)
+	{
+		gSCManagerBattleState->players[0].costume = np_get_host_costume(); /* host's pick from the Online menu */
+	}
+	for (slot = 1; slot < MAXCONTROLLERS; slot++)
+	{
+		if (np_slot_used(slot) != 0)
+		{
+			count++;
+		}
+	}
+	return count;
+}
+
+sb32 syNetLobbyIsParticipant(s32 player)
+{
+	return ((player >= 0) && (player < MAXCONTROLLERS) && (sSYNetLobbyMask & (1U << player))) ? TRUE : FALSE;
+}
+
+static void syNetLobbyLeaveMatch(void)
+{
+	sSYNetLobbyIsMatch = FALSE;
+	sSYNetLobbyIsRun = FALSE;
+	sSYNetLobbyIsSession = FALSE;
+	sSYNetLobbyIsHeld = FALSE;
+	sSYNetLobbyMask = 0;
+	gSCManagerSceneData.coop_player3 = 0xFF; /* no third human outside an online run */
+}
+
+sb32 syNetLobbyIsRun(void)
+{
+	return sSYNetLobbyIsRun;
+}
