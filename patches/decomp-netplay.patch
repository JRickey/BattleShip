diff --git a/src/sys/netinput.c b/src/sys/netinput.c
index c6ecef7..3e6d3e0 100644
--- a/src/sys/netinput.c
+++ b/src/sys/netinput.c
@@ -1,5 +1,6 @@
 #include <sys/netinput.h>
 
+#include <sys/netlobby.h>
 #include <sys/netpeer.h>
 #include <sys/taskman.h>
 
@@ -532,12 +533,68 @@ sb32 syNetInputGetReplayMetadata(SYNetInputReplayMetadata *out_metadata)
 	return TRUE;
 }
 
+#ifdef PORT
+/* Online lockstep read. Every slot (including the local one) is driven by the
+ * confirmed input for tick T; the local sample taken now is only applied at
+ * T + delay on every peer. If any participant's input for T has not arrived,
+ * the tick is held: nothing is published and battle execution stays blocked. */
+static void syNetInputFuncReadNetplay(void)
+{
+	SYNetInputFrame frame;
+	u32 tick;
+	s32 player;
+	u16 buttons;
+	s8 stick_x, stick_y;
+
+	syControllerFuncRead();
+	tick = sSYNetInputTick;
+
+	if (syNetLobbyCheckInputsReady(tick) == FALSE)
+	{
+		syNetLobbySetHeld(TRUE);
+		return;
+	}
+	syNetLobbySampleLocal(tick);
+	syNetLobbySetHeld(FALSE);
+	syNetLobbyReseedTick(tick);
+
+	for (player = 0; player < MAXCONTROLLERS; player++)
+	{
+		syNetLobbyGetFrame(player, tick, &buttons, &stick_x, &stick_y);
+		syNetInputMakeFrame(&frame, tick, buttons, stick_x, stick_y, nSYNetInputSourceRemoteConfirmed, FALSE);
+		sSYNetInputSlots[player].last_confirmed = frame;
+		syNetInputPublishFrame(player, &frame);
+
+		if (sSYNetInputIsRecording != FALSE)
+		{
+			syNetInputSetReplayFrame(player, tick, &frame);
+		}
+	}
+	syNetInputPublishMainController();
+
+	for (player = 0; player < MAXCONTROLLERS; player++)
+	{
+		sSYNetInputPublishedChecksum = syNetInputAccumulateInputChecksum(
+			sSYNetInputPublishedChecksum, player, &sSYNetInputSlots[player].last_published);
+	}
+	sSYNetInputPublishedTickCount++;
+	sSYNetInputTick++;
+}
+#endif
+
 void syNetInputFuncRead(void)
 {
 	SYNetInputFrame frame;
 	u32 tick;
 	s32 player;
 
+#ifdef PORT
+	if (syNetLobbyIsMatch() != FALSE)
+	{
+		syNetInputFuncReadNetplay();
+		return;
+	}
+#endif
 	syControllerFuncRead();
 	tick = syNetInputGetTick();
 
diff --git a/src/sys/netlobby.c b/src/sys/netlobby.c
new file mode 100644
index 0000000..09d3249
--- /dev/null
+++ b/src/sys/netlobby.c
@@ -0,0 +1,566 @@
+#include <sys/netlobby.h>
+
+#ifdef PORT
+
+#include <ft/fighter.h>
+#include <sc/scmanager.h>
+#include <sys/controller.h>
+#include <sys/netinput.h>
+#include <sys/netreplay.h>
+#include <sys/utils.h>
+
+#include <string.h>
+
+#include <sys/taskman.h>
+#include <lb/lbbackup.h>
+
+#include <netplay/netplay.h>
+
+extern void portSCManagerRequestScene(s32 scene);
+extern void portSCManagerRequestSceneEx(s32 scene, s32 scene_prev);
+extern void portSCManagerRequestReset(void);
+extern void port_log(const char *fmt, ...);
+
+#define SYNETLOBBY_RUN_MAGIC 0x53524E31 /* "SRN1" */
+
+/* Config for an online 1P co-op run (sent host -> client instead of VS metadata). */
+typedef struct SYNetLobbyRunConfig
+{
+	u32 magic;
+	u32 rng_seed;
+	u8 player, fkind, costume, shade;
+	u8 coop_player2, coop_fkind2, coop_costume2, coop_shade2;
+	u8 coop_pkind2, coop_level2, spgame_stage, difficulty;
+	u8 stock_count, friendly_fire, pad[2];
+
+} SYNetLobbyRunConfig;
+
+static sb32 sSYNetLobbyIsMatch;
+static sb32 sSYNetLobbyIsRun;
+static sb32 sSYNetLobbyIsSession; /* lockstep started (StartVSSession / StartRunSession ran) */
+static u32 sSYNetLobbyRunSeed;
+static sb32 sSYNetLobbyFriendlyFire;
+static sb32 sSYNetLobbyIsHeld;
+static s32 sSYNetLobbyLocalSlot;
+static u32 sSYNetLobbyMask;
+static u32 sSYNetLobbyDelay;
+
+static const char *sSYNetLobbyFighterNames[] =
+{
+	"Mario", "Fox", "Donkey Kong", "Samus", "Luigi", "Link",
+	"Yoshi", "Captain Falcon", "Kirby", "Pikachu", "Jigglypuff", "Ness"
+};
+
+s32 syNetLobbyGetFighterCount(void)
+{
+	return nFTKindPlayableEnd - nFTKindPlayableStart + 1;
+}
+
+const char *syNetLobbyGetFighterName(s32 index)
+{
+	if ((index < 0) || (index >= syNetLobbyGetFighterCount()))
+	{
+		return "?";
+	}
+	return sSYNetLobbyFighterNames[index];
+}
+
+s32 syNetLobbyGetFighterKind(s32 index)
+{
+	if ((index < 0) || (index >= syNetLobbyGetFighterCount()))
+	{
+		index = 0;
+	}
+	return nFTKindPlayableStart + index;
+}
+
+sb32 syNetLobbyIsMatch(void)
+{
+	return sSYNetLobbyIsMatch;
+}
+
+sb32 syNetLobbyIsClient(void)
+{
+	return (np_state() == NP_CONNECTED) ? TRUE : FALSE;
+}
+
+s32 syNetLobbyGetRemoteCount(void)
+{
+	s32 slot, count = 0;
+
+	if (np_state() != NP_HOSTING)
+	{
+		return 0;
+	}
+	for (slot = 1; slot < MAXCONTROLLERS; slot++)
+	{
+		if (np_slot_used(slot) != 0)
+		{
+			count++;
+		}
+	}
+	return count;
+}
+
+sb32 syNetLobbyIsParticipant(s32 player)
+{
+	return ((player >= 0) && (player < MAXCONTROLLERS) && (sSYNetLobbyMask & (1U << player))) ? TRUE : FALSE;
+}
+
+static void syNetLobbyLeaveMatch(void)
+{
+	sSYNetLobbyIsMatch = FALSE;
+	sSYNetLobbyIsRun = FALSE;
+	sSYNetLobbyIsSession = FALSE;
+	sSYNetLobbyIsHeld = FALSE;
+	sSYNetLobbyMask = 0;
+}
+
+sb32 syNetLobbyIsRun(void)
+{
+	return sSYNetLobbyIsRun;
+}
+
+static void syNetLobbyApplyRunConfig(const SYNetLobbyRunConfig *cfg)
+{
+	gSCManagerSceneData.player = cfg->player;
+	gSCManagerSceneData.fkind = cfg->fkind;
+	gSCManagerSceneData.costume = cfg->costume;
+	gSCManagerSceneData.spgame_stage = cfg->spgame_stage;
+	gSCManagerSceneData.coop_player2 = cfg->coop_player2;
+	gSCManagerSceneData.coop_fkind2 = cfg->coop_fkind2;
+	gSCManagerSceneData.coop_costume2 = cfg->coop_costume2;
+	gSCManagerSceneData.coop_shade2 = cfg->coop_shade2;
+	gSCManagerSceneData.coop_pkind2 = cfg->coop_pkind2;
+	gSCManagerSceneData.coop_level2 = cfg->coop_level2;
+	gSCManagerBackupData.spgame_difficulty = cfg->difficulty;
+	gSCManagerBackupData.spgame_stock_count = cfg->stock_count;
+	sSYNetLobbyRunSeed = cfg->rng_seed;
+	sSYNetLobbyFriendlyFire = cfg->friendly_fire;
+}
+
+/* Host, VS CSS in classic (1P co-op) context: the host pressed Start. Freeze the
+ * lobby into an online run: P1 = host, P2 = the connected client. */
+sb32 syNetLobbyBeginHostRun(void)
+{
+	SYNetLobbyRunConfig cfg;
+	int fighter, costume;
+
+	if ((sSYNetLobbyIsMatch != FALSE) || (np_state() != NP_HOSTING) || (np_get_mode() != 1) ||
+	    (np_player_count() != 2))
+	{
+		return FALSE;
+	}
+	np_slot_choice(1, &fighter, &costume);
+
+	memset(&cfg, 0, sizeof(cfg));
+	cfg.magic = SYNETLOBBY_RUN_MAGIC;
+	cfg.rng_seed = syUtilsRandSeed();
+	cfg.player = 0;
+	cfg.fkind = gSCManagerSceneData.fkind;
+	cfg.costume = gSCManagerSceneData.costume;
+	cfg.spgame_stage = gSCManagerSceneData.spgame_stage;
+	cfg.coop_player2 = 1;
+	cfg.coop_fkind2 = syNetLobbyGetFighterKind(fighter);
+	cfg.coop_costume2 = costume & 3;
+	cfg.coop_shade2 = 0;
+	cfg.coop_pkind2 = nFTPlayerKindMan;
+	cfg.coop_level2 = 0;
+	/* Difficulty and lives come from the host's Online menu, not the CSS. */
+	cfg.difficulty = np_get_run_difficulty();
+	cfg.stock_count = np_get_run_stocks();
+	cfg.friendly_fire = np_get_friendly_fire() ? 1 : 0;
+	sSYNetLobbyFriendlyFire = cfg.friendly_fire;
+
+	/* Same fighter + costume as P1: use the next costume so they look different. */
+	if ((cfg.coop_fkind2 == cfg.fkind) && (cfg.coop_costume2 == cfg.costume))
+	{
+		cfg.coop_costume2 = (cfg.coop_costume2 + 1) & 3;
+	}
+	if (np_host_begin_match(&cfg, sizeof(cfg)) == 0)
+	{
+		return FALSE;
+	}
+	syNetLobbyApplyRunConfig(&cfg);
+
+	sSYNetLobbyIsMatch = TRUE;
+	sSYNetLobbyIsRun = TRUE;
+	sSYNetLobbyIsHeld = TRUE;
+	sSYNetLobbyLocalSlot = 0;
+	sSYNetLobbyMask = np_match_mask();
+	sSYNetLobbyDelay = np_match_delay();
+	port_log("SSB64 NetLobby: host 1P co-op run begin mask=0x%x delay=%u seed=%u\n", sSYNetLobbyMask, sSYNetLobbyDelay, cfg.rng_seed);
+	return TRUE;
+}
+
+/* Common lockstep setup: every slot driven by confirmed inputs, neutral prefill. */
+static void syNetLobbyStartSession(void)
+{
+	s32 slot;
+	u32 tick;
+
+	sSYNetLobbyIsHeld = TRUE;
+	sSYNetLobbyIsSession = TRUE;
+
+	for (slot = 0; slot < MAXCONTROLLERS; slot++)
+	{
+		if (syNetLobbyIsParticipant(slot) != FALSE)
+		{
+			syNetInputSetSlotSource(slot, nSYNetInputSourceRemoteConfirmed);
+
+			for (tick = 0; tick < sSYNetLobbyDelay; tick++)
+			{
+				np_put_input(slot, tick, 0, 0, 0);
+			}
+		}
+		else syNetInputSetSlotSource(slot, nSYNetInputSourceSaved); /* idle: neutral input */
+	}
+	np_ready();
+}
+
+/* Top of sc1PManagerUpdateScene: the whole 1P run (every sub-scene) is one lockstep session. */
+void syNetLobbyStartRunSession(void)
+{
+	if ((sSYNetLobbyIsRun == FALSE) || (sSYNetLobbyIsSession != FALSE))
+	{
+		return; /* not an online run, or this run's session already started */
+	}
+	syUtilsSetRandomSeed(sSYNetLobbyRunSeed);
+	syNetInputStartVSSession();
+	syNetLobbyStartSession();
+}
+
+void (*syNetLobbyFilterControllerFunc(void (*func)(void)))(void)
+{
+	if (sSYNetLobbyIsRun != FALSE)
+	{
+		switch (gSCManagerSceneData.scene_curr)
+		{
+		case nSCKindTitle:
+		case nSCKindModeSelect:
+		case nSCKind1PMode:
+		case nSCKindVSMode:
+		case nSCKindPlayersVS:
+		case nSCKind1PGamePlayers:
+		case nSCKindOpeningRoom:
+		case nSCKindAutoDemo:
+#if defined(REGION_US)
+		case nSCKindStartup:
+#endif
+			/* Back in the menus: the run is over. */
+			np_end_match();
+			syNetLobbyLeaveMatch();
+			return func;
+
+		default:
+			if (func == syControllerFuncRead)
+			{
+				return syNetInputFuncRead;
+			}
+			break;
+		}
+	}
+	return func;
+}
+
+sb32 syNetLobbyCheckUpdateHeld(void)
+{
+	if ((sSYNetLobbyIsMatch == FALSE) || (sSYNetLobbyIsSession == FALSE))
+	{
+		return FALSE;
+	}
+	return (syNetLobbyCheckExecutionReady() == FALSE) ? TRUE : FALSE;
+}
+
+/* Host: freeze lobby into a match. Remote slots become human fighters with the
+ * peer's chosen character; everything is funnelled through the replay metadata
+ * so host and clients build the battle from byte-identical data. */
+void syNetLobbyBeginHostMatch(void)
+{
+	SYNetInputReplayMetadata metadata;
+	s32 slot;
+
+	if ((sSYNetLobbyIsMatch != FALSE) || (np_state() != NP_HOSTING) || (np_player_count() < 2))
+	{
+		return;
+	}
+	for (slot = 1; slot < MAXCONTROLLERS; slot++)
+	{
+		if (np_slot_used(slot) != 0)
+		{
+			int fighter, costume;
+
+			np_slot_choice(slot, &fighter, &costume);
+
+			s32 other, tries;
+
+			gSCManagerBattleState->players[slot].pkind = nFTPlayerKindMan;
+			gSCManagerBattleState->players[slot].fkind = syNetLobbyGetFighterKind(fighter);
+			costume &= 3;
+
+			/* Same fighter + same costume as an earlier slot looks identical: bump the costume. */
+			for (tries = 0; tries < 4; tries++)
+			{
+				sb32 is_used = FALSE;
+
+				for (other = 0; other < slot; other++)
+				{
+					if ((gSCManagerBattleState->players[other].pkind != nFTPlayerKindNot) &&
+					    (gSCManagerBattleState->players[other].fkind == gSCManagerBattleState->players[slot].fkind) &&
+					    (gSCManagerBattleState->players[other].costume == costume))
+					{
+						is_used = TRUE;
+					}
+				}
+				if (is_used == FALSE)
+				{
+					break;
+				}
+				costume = (costume + 1) & 3;
+			}
+			gSCManagerBattleState->players[slot].costume = costume;
+		}
+	}
+	syNetReplayCaptureBattleMetadata(gSCManagerBattleState, &metadata);
+
+	if (np_host_begin_match(&metadata, sizeof(metadata)) == 0)
+	{
+		return;
+	}
+	syNetReplayApplyBattleMetadata(&metadata);
+	syUtilsSetRandomSeed(metadata.rng_seed);
+	sSYNetLobbyRunSeed = metadata.rng_seed;
+
+	sSYNetLobbyIsMatch = TRUE;
+	sSYNetLobbyIsHeld = TRUE;
+	sSYNetLobbyLocalSlot = 0;
+	sSYNetLobbyMask = np_match_mask();
+	sSYNetLobbyDelay = np_match_delay();
+	port_log("SSB64 NetLobby: host match begin mask=0x%x delay=%u seed=%u\n", sSYNetLobbyMask, sSYNetLobbyDelay, metadata.rng_seed);
+}
+
+void syNetLobbyStartVSSession(void)
+{
+	if ((sSYNetLobbyIsMatch == FALSE) || (sSYNetLobbyIsRun != FALSE))
+	{
+		return;
+	}
+	syUtilsSetRandomSeed(sSYNetLobbyRunSeed); /* both peers start from the identical seed */
+	syNetLobbyStartSession();
+}
+
+void syNetLobbyStopVSSession(void)
+{
+	if ((sSYNetLobbyIsMatch != FALSE) && (sSYNetLobbyIsRun == FALSE))
+	{
+		np_end_match();
+		syNetLobbyLeaveMatch();
+	}
+}
+
+sb32 syNetLobbyCheckExecutionReady(void)
+{
+	return ((np_start_released() != 0) && (sSYNetLobbyIsHeld == FALSE)) ? TRUE : FALSE;
+}
+
+void syNetLobbySetHeld(sb32 is_held)
+{
+	sSYNetLobbyIsHeld = is_held;
+}
+
+sb32 syNetLobbyCheckInputsReady(u32 tick)
+{
+	s32 slot;
+
+	if (np_start_released() == 0)
+	{
+		return FALSE;
+	}
+	for (slot = 0; slot < MAXCONTROLLERS; slot++)
+	{
+		if (syNetLobbyIsParticipant(slot) != FALSE)
+		{
+			if (np_get_input(slot, tick, NULL, NULL, NULL) == 0)
+			{
+				return FALSE;
+			}
+		}
+	}
+	return TRUE;
+}
+
+/* The local player always uses physical controller port 0. The sample taken at
+ * tick T is applied at T + delay by every peer, including this one. */
+void syNetLobbySampleLocal(u32 tick)
+{
+	SYController *controller = &gSYControllerDevices[0];
+
+	np_put_input(sSYNetLobbyLocalSlot, tick + sSYNetLobbyDelay, controller->button_hold,
+	             controller->stick_range.x, controller->stick_range.y);
+}
+
+sb32 syNetLobbyGetFrame(s32 player, u32 tick, u16 *buttons, s8 *stick_x, s8 *stick_y)
+{
+	*buttons = 0;
+	*stick_x = 0;
+	*stick_y = 0;
+
+	if (syNetLobbyIsParticipant(player) == FALSE)
+	{
+		return FALSE;
+	}
+	return (np_get_input(player, tick, buttons, stick_x, stick_y) != 0) ? TRUE : FALSE;
+}
+
+static void syNetLobbyAbort(void)
+{
+	port_log("SSB64 NetLobby: match aborted (%s)\n", np_abort_reason());
+	np_end_match();
+	syNetLobbyLeaveMatch();
+	portSCManagerRequestReset();
+}
+
+void syNetLobbyFrame(void)
+{
+	static s32 sPrevState = NP_IDLE;
+	static s32 sPrevMode = -1;
+	s32 state;
+
+	np_poll();
+
+	/* Joining or hosting takes you to the VS character select screen, where
+	 * everybody waits for the host to start the match. */
+	state = np_state();
+	if (state != sPrevState)
+	{
+		if (((state == NP_HOSTING) || (state == NP_CONNECTED)) && (sSYNetLobbyIsMatch == FALSE) && (np_match_active() == 0))
+		{
+			extern void port_classic_coop_set_context(int);
+
+			/* Host in 1P co-op mode: open the VS CSS in classic (1P) context. */
+			port_classic_coop_set_context((state == NP_HOSTING) && (np_get_mode() == 1));
+			if (state == NP_HOSTING)
+			{
+				gSCManagerTransferBattleState.is_reset_players = TRUE;
+			}
+			portSCManagerRequestScene(nSCKindPlayersVS);
+		}
+		sPrevState = state;
+	}
+
+	/* Host switched VS <-> 1P in the Online menu without closing the room: reopen the CSS in the right context. */
+	if ((state == NP_HOSTING) && (sSYNetLobbyIsMatch == FALSE) && (np_match_active() == 0))
+	{
+		s32 mode = np_get_mode();
+
+		if ((sPrevMode != -1) && (mode != sPrevMode))
+		{
+			extern void port_classic_coop_set_context(int);
+
+			port_classic_coop_set_context(mode == 1);
+			gSCManagerTransferBattleState.is_reset_players = TRUE;
+			portSCManagerRequestScene(nSCKindPlayersVS);
+		}
+		sPrevMode = mode;
+	}
+	else if (state != NP_HOSTING)
+	{
+		sPrevMode = -1;
+	}
+	if (np_consume_abort() != 0)
+	{
+		syNetLobbyAbort();
+		return;
+	}
+	if ((sSYNetLobbyIsMatch != FALSE) && (np_state() != NP_HOSTING) && (np_state() != NP_CONNECTED))
+	{
+		syNetLobbyAbort();
+		return;
+	}
+	if ((np_state() == NP_CONNECTED) && (sSYNetLobbyIsMatch == FALSE))
+	{
+		SYNetInputReplayMetadata metadata;
+		u8 blob[NP_MAX_BLOB];
+		s32 blob_size = np_client_take_match(blob, sizeof(blob));
+
+		if ((blob_size == (s32)sizeof(SYNetLobbyRunConfig)) && (((SYNetLobbyRunConfig*)blob)->magic == SYNETLOBBY_RUN_MAGIC))
+		{
+			SYNetLobbyRunConfig cfg;
+
+			memcpy(&cfg, blob, sizeof(cfg));
+			syNetLobbyApplyRunConfig(&cfg);
+
+			sSYNetLobbyIsMatch = TRUE;
+			sSYNetLobbyIsRun = TRUE;
+			sSYNetLobbyIsHeld = TRUE;
+			sSYNetLobbyLocalSlot = np_local_slot();
+			sSYNetLobbyMask = np_match_mask();
+			sSYNetLobbyDelay = np_match_delay();
+			port_log("SSB64 NetLobby: client 1P co-op run begin slot=%d mask=0x%x delay=%u seed=%u\n",
+			         sSYNetLobbyLocalSlot, sSYNetLobbyMask, sSYNetLobbyDelay, cfg.rng_seed);
+
+			/* Same entry the host takes from the CSS: scene 1P game, previous scene = VS CSS. */
+			portSCManagerRequestSceneEx(nSCKind1PGame, nSCKindPlayersVS);
+		}
+		else if (blob_size == (s32)sizeof(metadata))
+		{
+			memcpy(&metadata, blob, sizeof(metadata));
+			syNetReplayApplyBattleMetadata(&metadata);
+			syUtilsSetRandomSeed(metadata.rng_seed);
+			sSYNetLobbyRunSeed = metadata.rng_seed;
+
+			sSYNetLobbyIsMatch = TRUE;
+			sSYNetLobbyIsHeld = TRUE;
+			sSYNetLobbyLocalSlot = np_local_slot();
+			sSYNetLobbyMask = np_match_mask();
+			sSYNetLobbyDelay = np_match_delay();
+			port_log("SSB64 NetLobby: client match begin slot=%d mask=0x%x delay=%u seed=%u\n",
+			         sSYNetLobbyLocalSlot, sSYNetLobbyMask, sSYNetLobbyDelay, metadata.rng_seed);
+
+			portSCManagerRequestScene(nSCKindVSBattle);
+		}
+	}
+}
+
+
+/* Per-tick RNG resync: any RNG draw made outside the simulation (draw code, menus, local-only effects)
+ * can no longer push peers apart for more than one tick. Seed is a hash of (match seed, tick). */
+void syNetLobbyReseedTick(u32 tick)
+{
+	u32 h = sSYNetLobbyRunSeed ^ (tick * 2654435761U);
+
+	h ^= h >> 15;
+	h *= 2246822519U;
+	h ^= h >> 13;
+	syUtilsSetRandomSeed((s32)h);
+}
+
+sb32 syNetLobbyGetFriendlyFire(void) { return sSYNetLobbyFriendlyFire; }
+
+#else /* !PORT */
+sb32 syNetLobbyGetFriendlyFire(void) { return FALSE; }
+void syNetLobbyReseedTick(u32 tick) {}
+
+sb32 syNetLobbyIsMatch(void) { return FALSE; }
+sb32 syNetLobbyIsRun(void) { return FALSE; }
+sb32 syNetLobbyBeginHostRun(void) { return FALSE; }
+void syNetLobbyStartRunSession(void) {}
+void (*syNetLobbyFilterControllerFunc(void (*func)(void)))(void) { return func; }
+sb32 syNetLobbyCheckUpdateHeld(void) { return FALSE; }
+s32 syNetLobbyGetRemoteCount(void) { return 0; }
+sb32 syNetLobbyIsClient(void) { return FALSE; }
+void syNetLobbyFrame(void) {}
+void syNetLobbyBeginHostMatch(void) {}
+void syNetLobbyStartVSSession(void) {}
+void syNetLobbyStopVSSession(void) {}
+sb32 syNetLobbyCheckExecutionReady(void) { return TRUE; }
+sb32 syNetLobbyCheckInputsReady(u32 tick) { return TRUE; }
+void syNetLobbySetHeld(sb32 is_held) {}
+void syNetLobbySampleLocal(u32 tick) {}
+sb32 syNetLobbyGetFrame(s32 player, u32 tick, u16 *buttons, s8 *stick_x, s8 *stick_y) { return FALSE; }
+sb32 syNetLobbyIsParticipant(s32 player) { return FALSE; }
+s32 syNetLobbyGetFighterCount(void) { return 0; }
+const char *syNetLobbyGetFighterName(s32 index) { return ""; }
+s32 syNetLobbyGetFighterKind(s32 index) { return 0; }
+
+#endif
