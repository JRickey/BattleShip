 // 0x8013A920
+#ifdef PORT
+/* Online rooms: show every connected player on the native character select panels, as if they
+ * were all playing on this screen. Remote players are parked exactly like a human whose fighter is
+ * already selected (holder = none, held = none), so no cursor or puck logic can touch them. */
+static GObj *sMNPlayersVSNetPanel[GMCOMMON_PLAYERS_MAX];
+static s32 sMNPlayersVSNetFkind[GMCOMMON_PLAYERS_MAX];
+static s32 sMNPlayersVSNetCostume[GMCOMMON_PLAYERS_MAX];
+
+static void mnPlayersVSNetSyncPanels(void)
+{
+	s32 s;
+	sb32 is_host = (syNetLobbyIsClient() == FALSE) ? TRUE : FALSE;
+	sb32 enabled = syNetLobbyPanelsEnabled();
+
+	for (s = 0; s < GMCOMMON_PLAYERS_MAX; s++)
+	{
+		MNPlayersSlotVS *slot = &sMNPlayersVSSlots[s];
+		s32 fkind, costume;
+		sb32 has_choice;
+
+		if ((slot->panel == NULL) || (slot->type_button == NULL) || (slot->name_emblem_gobj == NULL) || (slot->puck == NULL))
+		{
+			continue; /* UI not built yet */
+		}
+		if (sMNPlayersVSNetPanel[s] != slot->panel)
+		{
+			sMNPlayersVSNetPanel[s] = slot->panel; /* fresh scene entry */
+			sMNPlayersVSNetFkind[s] = -1;
+			sMNPlayersVSNetCostume[s] = -1;
+		}
+		if ((is_host != FALSE) && (s == 0))
+		{
+			/* Host's own panel is the real one: just publish what it has picked. */
+			if (enabled != FALSE)
+			{
+				if ((slot->pkind == nFTPlayerKindMan) && (slot->is_selected != FALSE) && (slot->fkind != nFTKindNull))
+				{
+					syNetLobbyPublishHostChoice(slot->fkind, slot->costume);
+				}
+			}
+			continue;
+		}
+		has_choice = (enabled != FALSE) ? syNetLobbyGetPanelChoice(s, &fkind, &costume) : FALSE;
+
+		if (has_choice != FALSE)
+		{
+			if ((slot->pkind != nFTPlayerKindMan) || (sMNPlayersVSNetFkind[s] != fkind) || (sMNPlayersVSNetCostume[s] != costume))
+			{
+				if (slot->pkind != nFTPlayerKindMan)
+				{
+					slot->pkind = nFTPlayerKindMan;
+					mnPlayersVSUpdatePlayerKind(s);
+					mnPlayersVSUpdatePlayerKindSelect(slot->type_button, s, slot->pkind);
+				}
+				slot->fkind = fkind;
+				slot->costume = costume;
+				slot->is_selected = TRUE;
+				slot->is_fighter_selected = TRUE;
+				slot->holder_player = GMCOMMON_PLAYERS_MAX;
+				slot->held_player = -1;
+
+				mnPlayersVSCenterPuckInPortrait(slot->puck, fkind);
+				mnPlayersVSUpdateFighter(s);
+				mnPlayersVSUpdateNameAndEmblem(s);
+				mnPlayersVSUpdatePuckDisplay(slot->puck, s);
+
+				sMNPlayersVSNetFkind[s] = fkind;
+				sMNPlayersVSNetCostume[s] = costume;
+			}
+			if (slot->cursor != NULL)
+			{
+				slot->cursor->flags = GOBJ_FLAG_HIDDEN; /* nobody moves a remote cursor */
+			}
+		}
+		else if (sMNPlayersVSNetFkind[s] != -1)
+		{
+			/* Player left (or the room closed): give the panel back. */
+			sMNPlayersVSNetFkind[s] = -1;
+			sMNPlayersVSNetCostume[s] = -1;
+			slot->pkind = nFTPlayerKindNot;
+			mnPlayersVSUpdatePlayerKind(s);
+			mnPlayersVSUpdatePlayerKindSelect(slot->type_button, s, slot->pkind);
+			mnPlayersVSUpdateFighter(s);
+			mnPlayersVSUpdateNameAndEmblem(s);
+		}
+	}
+}
+#endif
